<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="WindowBg" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBtn" Color="#3730A3"/>
    <SolidColorBrush x:Key="PrimaryBtnHover" Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#4338CA"/>
    <SolidColorBrush x:Key="InputBorder" Color="#C7D2FE"/>
    <SolidColorBrush x:Key="MutedText" Color="#5B5F86"/>
    <SolidColorBrush x:Key="IconCircleBg" Color="#E8EBFF"/>

    <!-- Dashboard menu card: icon and text as content, with a round arrow button on the right -->
    <Style x:Key="DashboardCardStyle" TargetType="Button">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="card" Background="#EBFFFFFF" CornerRadius="14"
                            BorderThickness="1" BorderBrush="#E3E7FF" Padding="14,10,12,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.12" Color="#1E1B4B"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter VerticalAlignment="Center"/>

                            <Border x:Name="chevronCircle" Grid.Column="1" Width="26" Height="26" CornerRadius="13"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource IconCircleBg}">
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="64" Height="64">
                                        <Path x:Name="chevron" Data="{StaticResource Icon.Chevron}" Stroke="{StaticResource PrimaryBtn}"
                                              StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="card" Property="Background" Value="White"/>
                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource PrimaryBtn}"/>
                            <Setter TargetName="chevronCircle" Property="Background" Value="{StaticResource PrimaryBtn}"/>
                            <Setter TargetName="chevron" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="card" Property="Background" Value="#F5F7FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small borderless window button, e.g. minimize and close -->
    <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="chrome" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chrome" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeepSeaButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBtn}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBtnHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuCardStyle" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                        CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource InputBorder}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#1E1B4B"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F8FAFF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBtn}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>