<Window x:Class="PresentationLayer.Views.StaffAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Personalhantering"
        Width="1150" Height="760"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="{StaticResource MidnightGrayColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StaffGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <!-- Deactivated accounts are shown greyed out -->
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="#8A94A0"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackButton" Grid.Row="0" Content="← Tillbaka" Width="110" Height="36"
                HorizontalAlignment="Left" Margin="0,0,0,18"
                Style="{StaticResource DeepSeaButtonStyle}" Click="BackButton_Click"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource HeadingTextStyle}" Text="Personal" FontSize="26"/>
            <TextBlock Text="Se alla personalkonton, registrera nya och inaktivera konton för personal som slutat eller är tjänstlediga."
                       Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Staff list -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Personalkonton" FontSize="18" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock x:Name="StaffCountTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedText}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sök namn, e-post eller roll" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="StaffSearchTextBox"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowInactiveCheckBox" Grid.Column="1" Content="Visa inaktiverade"
                                  IsChecked="True" VerticalAlignment="Bottom" Margin="16,0,0,10"
                                  Foreground="{StaticResource PrimaryText}"/>
                    </Grid>

                    <Border Grid.Row="2" CornerRadius="10" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" Padding="1">
                        <DataGrid x:Name="StaffDataGrid" Style="{StaticResource StaffGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Namn" Binding="{Binding Name}" Width="1.2*"/>
                                <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="1.5*"/>
                                <DataGridTextColumn Header="Roll" Binding="{Binding Role}" Width="1.2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StaffListFeedbackTextBlock" Grid.Column="0" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="ToggleActiveButton" Grid.Column="1" Content="Inaktivera konto"
                                Width="170" Height="38" IsEnabled="False"
                                Style="{StaticResource DeepSeaButtonStyle}" Click="ToggleActiveButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Register new staff (unchanged form) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Registrera personal" FontSize="18" Margin="0,0,0,4" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="Skapa ett nytt konto och tilldela systembehörigheter." TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryText}" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Förnamn *" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="FirstNameTextBox"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Efternamn *" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="LastNameTextBox"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="E-postadress *" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="EmailTextBox" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Lösenord (minst 10 tecken) *"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,15,0"
                                           VerticalAlignment="Center"/>

                                <CheckBox x:Name="ShowPasswordCheckBox"
                                          Content="Visa lösenord"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource PrimaryText}"
                                          Checked="ShowPassword_Changed"
                                          Unchecked="ShowPassword_Changed"/>
                            </StackPanel>

                            <Grid>
                                <!-- Standard hidden input -->
                                <PasswordBox x:Name="PasswordBox"/>
                                <!-- Clear text input (hidden as standard) -->
                                <TextBox x:Name="PasswordVisibleTextBox" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="Systemroll *" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="RoleComboBox" Height="38" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <TextBlock x:Name="FeedbackTextBlock" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CancelButton" Grid.Column="0" Content="Rensa" Width="100" Height="40"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DeepSeaButtonStyle}" Click="CancelButton_Click"/>

                            <Button x:Name="SaveButton" Grid.Column="1" Content="Registrera konto" Width="160" Height="40"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CtaButtonStyle}" Click="SaveButton_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
