<Window x:Class="PresentationLayer.Views.StaffAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Personalhantering"
        Width="600" Height="750"
        MinWidth="600" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackButton" Grid.Row="0" Content="← Tillbaka" Width="110" Height="36" 
                HorizontalAlignment="Left" Margin="0,0,0,20"
                Style="{StaticResource DeepSeaButtonStyle}" Click="BackButton_Click"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Style="{StaticResource HeadingTextStyle}" Text="Registrera Personal" FontSize="26"/>
            <TextBlock Text="Skapa ett nytt konto och tilldela systembehörigheter." 
                       Foreground="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="15" Padding="30"
                BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="{StaticResource MidnightGrayColor}"/>
            </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Förnamn *" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FirstNameTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Efternamn *" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="LastNameTextBox"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="E-postadress *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EmailTextBox" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Lösenord (minst 10 tecken) *" 
                                   Style="{StaticResource LabelStyle}" 
                                   Margin="0,0,15,0"
                                   VerticalAlignment="Center"/>

                            <CheckBox x:Name="ShowPasswordCheckBox" 
                                  Content="Visa lösenord" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryText}"
                                  Checked="ShowPassword_Changed" 
                                  Unchecked="ShowPassword_Changed"/>
                        </StackPanel>

                        <Grid>
                            <!-- Standard hidden input -->
                            <PasswordBox x:Name="PasswordBox"/>
                            <!-- Clear text input (hidden as standard) -->
                            <TextBox x:Name="PasswordVisibleTextBox" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Systemroll *" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="RoleComboBox" Height="38" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>

                    <TextBlock x:Name="FeedbackTextBlock" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="CancelButton" Grid.Column="0" Content="Avbryt" Width="100" Height="40" 
                                HorizontalAlignment="Left"
                                Style="{StaticResource DeepSeaButtonStyle}" Click="CancelButton_Click"/>

                        <Button x:Name="SaveButton" Grid.Column="1" Content="Registrera konto" Width="160" Height="40" 
                                HorizontalAlignment="Right"
                                Style="{StaticResource CtaButtonStyle}" Click="SaveButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>