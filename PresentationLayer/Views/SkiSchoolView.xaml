<Window x:Class="PresentationLayer.Views.SkiSchoolView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Skidskola &amp; Lektioner" 
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E1B4B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainContentGrid" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Content="← Tillbaka" Width="110" Height="38"
                        Style="{StaticResource DeepSeaButtonStyle}"
                        Click="BtnBack_Click"/>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Skidskola &amp; Lektioner" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryText}"/>
                    <TextBlock Text="Boka grupp- och privatlektioner för gäster" FontSize="14" Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>

                <!-- Dropdown-->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Välj aktuell bokning:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBookings" Width="280" SelectionChanged="CmbBookings_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Main space -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filters -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Välj vecka:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbWeekNumber" SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nivå / Typ:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbLessonLevel" SelectionChanged="Filter_SelectionChanged"/>
                            </StackPanel>

                            <Button x:Name="BtnRefresh" Grid.Column="4" Content="Uppdatera" Width="100" Height="38" 
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource DeepSeaButtonStyle}" 
                                    Click="BtnRefresh_Click"/>
                        </Grid>

                        <Separator Grid.Row="1" Background="{StaticResource InputBorder}" Opacity="0.5"/>

                        <!-- Datagrid -->
                        <DataGrid x:Name="DgSessions" Grid.Row="2" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  CanUserResizeColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeight="38"
                                  FontSize="13"
                                  Background="White"
                                  BorderThickness="0"
                                  SelectionChanged="DgSessions_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vecka" Binding="{Binding WeekNumber}" Width="65"/>
                                <DataGridTextColumn Header="Nivå" Binding="{Binding Level}" Width="105"/>
                                <DataGridTextColumn Header="Dagar" Binding="{Binding Days}" Width="95"/>
                                <DataGridTextColumn Header="Tid" Binding="{Binding TimeSlot}" Width="110"/>
                                <DataGridTextColumn Header="Platser" Binding="{Binding AvailabilityDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Pris (SEK)" Binding="{Binding PriceDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Right column: Details, Booking & Cancel -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Vald lektion" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="KOPPLAD BOKNING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSelectedBookingInfo" Text="Ingen bokning vald" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                            <TextBlock Text="NIVÅ &amp; PERIOD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSummaryTitle" Text="Ingen lektion vald" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                            <TextBlock Text="TIDSLUCKA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSummaryTime" Text="-" FontSize="14" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                            <TextBlock Text="TILLGÄNGLIGHET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSummarySpots" Text="-" FontSize="14" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                            <TextBlock Text="BOKADE PÅ VALD BOKNING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtCustomerBookedSpots" Text="0 platser" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,15"/>

                            <TextBlock Text="PRIS PER DELTAGARE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSummaryPrice" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBtn}" Margin="0,0,0,15"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button x:Name="BtnBookSession" Content="Boka lektion" Height="42"
                                    Style="{StaticResource DeepSeaButtonStyle}"
                                    IsEnabled="False"
                                    Click="BtnBookSession_Click"/>

                            <Button x:Name="BtnCancelSession" Content="Avboka plats" Height="40"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource DeepSeaButtonStyle}"
                                    IsEnabled="False"
                                    Click="BtnCancelSession_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading overlay.  -->
        <Grid x:Name="LoadingOverlay" Opacity="0" IsHitTestVisible="False" Background="#401E1B4B">
            <Border Background="White" CornerRadius="12" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z"
                          Fill="{StaticResource PrimaryBtn}" 
                          Width="40" Height="40" 
                          Stretch="Fill"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Text="Hämtar data..." Margin="0,15,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>