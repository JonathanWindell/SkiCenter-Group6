<Window x:Class="PresentationLayer.Views.EquipmentRentalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Uthyrning &amp; återlämmning"
        Width="1150"
        Height="760"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <!-- Shared look for the tables, matching the equipment view. -->
        <Style x:Key="RentalGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonStyle}">
            <Setter Property="Background" Value="#DCEAF7"/>
            <Setter Property="Foreground" Value="#2A2F36"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="24"
            Margin="16">

        <TabControl Background="Transparent" BorderThickness="0">

            <!-- Page 1, rental -->
            <TabItem Header="Uthyrning">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="← Tillbaka"
                                Width="110"
                                Height="36"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="BackButton_Click"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource HeadingFont}" Text="Uthyrning"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"/>
                        <TextBlock Text="Hyr ut till en boendegäst eller direkt över disk till drop-in kund."
                                   FontSize="14"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <!-- Selection for type of customer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RoomGuestRadioButton"
                             Content="Boendegäst (på rummet)"
                             IsChecked="True"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryText}"
                             Margin="0,0,16,0"
                             Checked="RentalType_Changed"/>
                        <RadioButton x:Name="DropInRadioButton"
                             Content="Drop-in (betala i kassa)"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryText}"
                             Checked="RentalType_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Booking search and selected booking -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="SearchHeaderTextBlock"
                                       Text="Bokningsnummer eller lägenhetsnummer" 
                                       Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BookingSearchTextBox"
                                         Height="36"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource InputBorder}"/>
                                <Button x:Name="SearchBookingButton"
                                        Grid.Column="2"
                                        Content="Sök"
                                        Width="90"
                                        Height="36"
                                        IsDefault="True"
                                        Style="{StaticResource DeepSeaButtonStyle}"/>
                            </Grid>

                            <TextBlock x:Name="BookingSearchMessage"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#DC2626"
                                       Visibility="Collapsed"/>

                            <ComboBox x:Name="BookingResultsComboBox"
                                      Height="36"
                                      Margin="0,8,0,0"
                                      VerticalContentAlignment="Center"
                                      Visibility="Collapsed"/>
                        </StackPanel>

                        <Border x:Name="BookingInfoBorder"
                                Grid.Column="2"
                                Background="{StaticResource WindowBg}"
                                CornerRadius="12"
                                Padding="16,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="BookingTitleTextBlock"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock x:Name="BookingCustomerTextBlock" Foreground="{StaticResource PrimaryText}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="BookingStayTextBlock" Foreground="{StaticResource PrimaryText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="BookingTotalTextBlock"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}"/>
                                    <TextBlock x:Name="BookingRentalsTextBlock"
                                               Foreground="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                    <Button x:Name="EditExistingRentalButton"
                                            Content="✏ Ändra hyrd utrustning"
                                            Height="28"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="EditExistingRentalButton_Click"
                                            Visibility="Collapsed"/>
                                            </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Equipment selection -->
                    <Grid x:Name="EquipmentPanel" Grid.Row="2" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- Available equipment -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kategori" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="CategoryFilterComboBox"
                                              Height="36"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sök artikelnummer eller modell" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="ItemSearchTextBox"
                                             Height="36"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource InputBorder}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource InputBorder}"
                                    BorderThickness="1"
                                    Padding="1">
                                <DataGrid x:Name="AvailableItemsDataGrid"
                                          Style="{StaticResource RentalGridStyle}"
                                          SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Artikelnr" Binding="{Binding ArticleNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Kategori" Binding="{Binding Equipment.Category}" Width="*"/>
                                        <DataGridTextColumn Header="Modell" Binding="{Binding Equipment.Description}" Width="1.3*"/>
                                        <DataGridTextColumn Header="Storlek" Binding="{Binding Size}" Width="0.8*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock x:Name="AvailableCountTextBlock"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryText}"/>
                                <Button x:Name="AddToRentalButton"
                                        Content="Lägg till valda →"
                                        Width="160"
                                        Height="36"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource DeepSeaButtonStyle}"/>
                            </Grid>
                        </Grid>

                        <!-- Selected equipment and rental details -->
                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Vald utrustning"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryText}"
                                           Margin="0,0,0,10"/>

                                <Border Grid.Row="1"
                                        CornerRadius="8"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1"
                                        Padding="1">
                                    <DataGrid x:Name="SelectedItemsDataGrid"
                                              Style="{StaticResource RentalGridStyle}"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Artikelnr" Binding="{Binding ArticleNumber}" Width="*"/>
                                            <DataGridTextColumn Header="Utrustning" Binding="{Binding Name}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Pris (kr)" Binding="{Binding PriceText}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Button x:Name="RemoveFromRentalButton"
                                            Content="Ta bort valda"
                                            Height="32"
                                            Width="130"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Från och med *" 
                                                       Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="StartDatePicker" Height="36"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Till och med *" 
                                                       Style="{StaticResource LabelStyle}"/>
                                            <DatePicker x:Name="EndDatePicker" Height="36"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="RentalSummaryTextBlock"
                                               Margin="0,12,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}"/>

                                    <!-- Only shown when a snowmobile is selected -->
                                    <Border x:Name="LicenseBorder"
                                            Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="8"
                                            Background="#FFF7ED"
                                            BorderBrush="#F59E0B"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Skoter kräver körkort"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                            <CheckBox x:Name="LicenseVerifiedCheckBox"
                                                      Margin="0,6,0,0"
                                                      Content="Körkort kontrollerat *"
                                                      Foreground="{StaticResource PrimaryText}"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="RentalFeedbackTextBlock"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#DC2626"/>
                                </StackPanel>

                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ConfirmRentalButton"
                                            Grid.Column="0"
                                            Content="Lägg till på bokningen"
                                            Height="38"
                                            IsEnabled="False"
                                            Style="{StaticResource CtaButtonStyle}"/>

                                    <Button x:Name="CancelEditRentalButton"
                                            Grid.Column="1"
                                            Content="Avbryt"
                                            Height="38"
                                            Width="80"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="CancelEditRentalButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Page 2, returns -->
            <TabItem Header="Återlämning">
                <Grid Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                            Content="← Tillbaka"
                            Width="110"
                            Height="36"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="BackButton_Click"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource HeadingFont}" Text="Återlämning"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"/>
                        <TextBlock Text="Scanna eller mata in artikelnummer för att lägga till artiklar och godkänna återlämning."
                                   FontSize="14"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Scanna eller ange artikel"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryText}"
                                           Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Artikelnummer *" Style="{StaticResource LabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ReturnArticleTextBox"
                                                 Height="36"
                                                 Padding="8,4"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="{StaticResource InputBorder}"/>
                                        <Button x:Name="SearchReturnItemButton"
                                                Grid.Column="2"
                                                Content="Sök artikel"
                                                Width="110"
                                                Height="34"
                                                Style="{StaticResource DeepSeaButtonStyle}"/>
                                    </Grid>

                                    <TextBlock x:Name="ReturnSearchFeedbackTextBlock"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#DC2626"/>
                                </StackPanel>

                                <Border x:Name="ScannedItemDetailBorder"
                                        Grid.Row="2"
                                        Background="{StaticResource WindowBg}"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,15,0,15"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ScannedItemTitleTextBlock"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryText}"/>
                                        <TextBlock x:Name="ScannedItemCategoryTextBlock"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource PrimaryText}"/>
                                        <TextBlock x:Name="ScannedItemRentalInfoTextBlock"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource SecondaryText}"/>

                                        <Border x:Name="DelayWarningBorder"
                                                Background="#FEE2E2"
                                                BorderBrush="#DC2626"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="DelayWarningTextBlock"
                                                       FontWeight="SemiBold"
                                                       Foreground="#991B1B"/>
                                        </Border>

                                        <Separator Margin="0,14,0,12" 
                                                   Background="{StaticResource InputBorder}"/>

                                        <TextBlock Text="Bedöm skick vid inlämning:" 
                                                   Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="ReturnConditionComboBox"
                                                  Height="36"
                                                  Margin="0,0,0,12"
                                                  VerticalContentAlignment="Center"/>

                                        <CheckBox x:Name="ReturnIsDamagedCheckBox"
                                                  Content="Utrustningen är skadad / kräver service"
                                                  Foreground="{StaticResource PrimaryText}"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="AddScannedItemToListButton"
                                        Grid.Row="3"
                                        Content="Lägg till i lista →"
                                        Width="160"
                                        Height="38"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False"
                                        Style="{StaticResource DeepSeaButtonStyle}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                    Text="Artiklar att checka in"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryText}"
                                    Margin="0,0,0,10"/>

                                <Border Grid.Row="1"
                                        CornerRadius="8"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1"
                                        Padding="1">
                                    <DataGrid x:Name="ReturnQueueDataGrid"
                                              Style="{StaticResource RentalGridStyle}"
                                              SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Artikelnr" Binding="{Binding ArticleNumber}" Width="100"/>
                                            <DataGridTextColumn Header="Utrustning" Binding="{Binding Description}" Width="*"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Button x:Name="RemoveFromReturnQueueButton"
                                            Content="Ta bort valda"
                                            Height="32"
                                            Width="130"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SecondaryButtonStyle}"/>

                                    <TextBlock x:Name="ReturnQueueSummaryTextBlock"
                                               Margin="0,12,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}"
                                               Text="Ingen utrustning i listan."/>
                                </StackPanel>

                                <Button x:Name="ConfirmAllReturnsButton"
                                        Grid.Row="3"
                                        Content="Godkänn återlämning"
                                        Height="38"
                                        Margin="0,12,0,0"
                                        IsEnabled="False"
                                        Style="{StaticResource CtaButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</Window>
