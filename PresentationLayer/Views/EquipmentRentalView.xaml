<Window x:Class="PresentationLayer.Views.EquipmentRentalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Uthyrning"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <!-- Shared look for the tables, matching the equipment view. -->
        <Style x:Key="RentalGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header matches the ski school view. -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="← Tillbaka"
                    Width="110"
                    Height="36"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Uthyrning"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Sök en aktiv rumsbokning och lägg till utrustning som betalas på rummet."
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource CardBg}"
                CornerRadius="15"
                Padding="20"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="2"
                                  Opacity="0.08"
                                  Color="#1E1B4B"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Booking search and selected booking -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Bokningsnummer eller lägenhetsnummer" Style="{StaticResource LabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BookingSearchTextBox"
                                 Height="34"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource InputBorder}"/>
                            <Button x:Name="SearchBookingButton"
                                Grid.Column="2"
                                Content="Sök"
                                Width="90"
                                Height="34"
                                IsDefault="True"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        </Grid>

                        <TextBlock x:Name="BookingSearchMessage"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#DC2626"
                               Visibility="Collapsed"/>

                        <ComboBox x:Name="BookingResultsComboBox"
                              Height="32"
                              Margin="0,8,0,0"
                              VerticalContentAlignment="Center"
                              Visibility="Collapsed"/>
                    </StackPanel>

                    <Border x:Name="BookingInfoBorder"
                        Grid.Column="2"
                        Background="{StaticResource WindowBg}"
                        CornerRadius="12"
                        Padding="14,10"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="BookingTitleTextBlock"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"/>
                                <TextBlock x:Name="BookingCustomerTextBlock" Foreground="{StaticResource PrimaryText}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="BookingStayTextBlock" Foreground="{StaticResource PrimaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="BookingTotalTextBlock"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryText}"/>
                                <TextBlock x:Name="BookingRentalsTextBlock"
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Equipment selection -->
                <Grid x:Name="EquipmentPanel" Grid.Row="2" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Available equipment -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kategori" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="CategoryFilterComboBox"
                                      Height="32"
                                      VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sök artikelnummer eller modell" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ItemSearchTextBox"
                                     Height="32"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource InputBorder}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                            CornerRadius="12"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            Padding="1">
                            <DataGrid x:Name="AvailableItemsDataGrid"
                                  Style="{StaticResource RentalGridStyle}"
                                  SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Artikelnr" Binding="{Binding ArticleNumber}" Width="*"/>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding Equipment.Category}" Width="*"/>
                                    <DataGridTextColumn Header="Modell" Binding="{Binding Equipment.Description}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Storlek" Binding="{Binding Size}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="AvailableCountTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryText}"/>
                            <Button x:Name="AddToRentalButton"
                                Content="Lägg till valda →"
                                Width="160"
                                Height="36"
                                HorizontalAlignment="Right"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        </Grid>
                    </Grid>

                    <!-- Selected equipment and rental details -->
                    <Border Grid.Column="2"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                   Text="Vald utrustning"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                            <Border Grid.Row="1"
                                CornerRadius="8"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                Padding="1">
                                <DataGrid x:Name="SelectedItemsDataGrid"
                                      Style="{StaticResource RentalGridStyle}"
                                      SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Artikelnr" Binding="{Binding ArticleNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Utrustning" Binding="{Binding Name}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Pris (kr)" Binding="{Binding PriceText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button x:Name="RemoveFromRentalButton"
                                    Content="Ta bort valda"
                                    Height="30"
                                    Width="130"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"/>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Från och med *" Style="{StaticResource LabelStyle}"/>
                                        <DatePicker x:Name="StartDatePicker" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Till och med *" Style="{StaticResource LabelStyle}"/>
                                        <DatePicker x:Name="EndDatePicker" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="RentalSummaryTextBlock"
                                       Margin="0,10,0,0"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryText}"/>

                                <!-- Only shown when a snowmobile is selected -->
                                <Border x:Name="LicenseBorder"
                                    Margin="0,10,0,0"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="#FFF7ED"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Skoter kräver körkort"
                                               FontWeight="SemiBold"
                                               Foreground="#92400E"/>
                                        <CheckBox x:Name="LicenseVerifiedCheckBox"
                                              Margin="0,6,0,0"
                                              Content="Körkort kontrollerat *"
                                              Foreground="{StaticResource PrimaryText}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="RentalFeedbackTextBlock"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#DC2626"/>
                            </StackPanel>

                            <Button x:Name="ConfirmRentalButton"
                                Grid.Row="3"
                                Content="Lägg till på bokningen"
                                Height="38"
                                Margin="0,10,0,0"
                                IsEnabled="False"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
