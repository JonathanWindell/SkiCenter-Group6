<Window x:Class="PresentationLayer.Views.CustomerBookingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Kundens bokningar"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header matches the ski school view. -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="← Tillbaka"
                    Width="110"
                    Height="36"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Kundens bokningar"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Sök efter en kund för att se aktuella och tidigare bokningar."
                           Margin="0,4,0,0"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource CardBg}"
                CornerRadius="15"
                Padding="20"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="2"
                                  Opacity="0.08"
                                  Color="#1E1B4B"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Customer search -->
                    <Border Grid.Row="1"
                            Margin="0,25,0,0"
                            Padding="20"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="10">

                        <StackPanel>

                            <TextBlock Text="Sök kund"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock Text="Sök med namn, e-post, telefonnummer, företagsnamn eller organisationsnummer."
                                       Margin="0,5,0,12"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CustomerSearchTextBox"
                                         Grid.Column="0"
                                         Height="38"
                                         Padding="10,7"
                                         Margin="0,0,12,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource InputBorder}"
                                         BorderThickness="1"
                                         FontSize="14"/>

                                <Button x:Name="SearchCustomerButton"
                                        Grid.Column="1"
                                        Content="Sök"
                                        Width="100"
                                        Height="38"
                                        Style="{StaticResource DeepSeaButtonStyle}"
                                        Click="SearchCustomer_Click"/>

                            </Grid>

                            <!-- Search error message -->
                            <TextBlock x:Name="CustomerSearchMessage"
                                       Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="Red"
                                       Visibility="Collapsed"/>

                        </StackPanel>
                    </Border>

                    <!-- Selected customer information -->
                    <Border x:Name="CustomerInformationBorder"
                            Grid.Row="2"
                            Margin="0,15,0,20"
                            Padding="15"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">

                        <StackPanel>

                            <TextBlock Text="VALD KUND"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="CustomerNameTextBlock"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock x:Name="CustomerEmailTextBlock"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>
                    </Border>

                    <!-- Message displayed when the customer has no bookings -->
                    <StackPanel x:Name="NoBookingsMessage"
                                Grid.Row="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">

                        <TextBlock Text="Kunden har inga bokningar."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock Text="Det finns inga bokningar registrerade på den här kunden."
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryText}"/>

                    </StackPanel>

                    <!-- Booking list -->
                    <Grid x:Name="BookingsScrollViewer"
                          Grid.Row="3"
                          Visibility="Collapsed">

                        <!-- Creates one booking card for each booking -->
                        <ItemsControl x:Name="BookingsItemsControl">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <!-- Booking card -->
                                    <Border Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Booking header -->
                                            <Grid Grid.Row="0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="Bokning #"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryText}"/>

                                                    <TextBlock Text="{Binding BookingID}"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryText}"/>

                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BookingStatus}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SecondaryText}"/>

                                            </Grid>

                                            <!-- Accommodation overview -->
                                            <StackPanel Grid.Row="1"
                                                        Margin="0,18,0,0">

                                                <TextBlock Text="BOENDE"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryText}"/>

                                                <ItemsControl ItemsSource="{Binding Accommodations}">

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>

                                                            <StackPanel Margin="0,5,0,0">

                                                                <TextBlock Foreground="{StaticResource SecondaryText}">

                                                                    <Run Text="{Binding StartDate,
                                                                        StringFormat={}{0:yyyy-MM-dd}}"/>

                                                                    <Run Text=" – "/>

                                                                    <Run Text="{Binding EndDate,
                                                                        StringFormat={}{0:yyyy-MM-dd}}"/>

                                                                </TextBlock>

                                                            </StackPanel>

                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>

                                                </ItemsControl>

                                            </StackPanel>

                                            <!-- Booking footer -->
                                            <Grid Grid.Row="2"
                                                  Margin="0,20,0,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <TextBlock Text="Totalt: "
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryText}"/>

                                                    <TextBlock Text="{Binding TotalAmount,
                                                        StringFormat={}{0:N0} kr}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryText}"/>

                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="Visa all information"
                                                        Width="170"
                                                        Height="38"
                                                        Tag="{Binding BookingID}"
                                                        Style="{StaticResource DeepSeaButtonStyle}"
                                                        Click="ShowAllInformation_Click"/>

                                            </Grid>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>

                    <!-- Footer buttons -->
                    <Grid Grid.Row="4"
                          Margin="0,20,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Opens the new booking form -->
                        <Button x:Name="CreateNewBookingButton"
                                Grid.Column="0"
                                Content="+ Skapa ny bokning"
                                Width="180"
                                Height="38"
                                HorizontalAlignment="Left"
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="CreateNewBooking_Click"/>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
