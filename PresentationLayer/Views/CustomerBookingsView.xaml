<Window x:Class="PresentationLayer.Views.CustomerBookingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Kundens bokningar"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Grid Margin="40">

        <!-- Main content card -->
        <Border Background="{StaticResource CardBg}"
                CornerRadius="18"
                Padding="35">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Kundens bokningar"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"/>

                    <TextBlock Text="Se kundens aktuella och tidigare bokningar."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>

                <!-- Customer information -->
                <Border Grid.Row="1"
                        Margin="0,25,0,20"
                        Padding="15"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>

                        <!-- Selected customer information -->
                        <TextBlock x:Name="CustomerNameTextBlock"
           FontSize="16"
           FontWeight="SemiBold"
           Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock x:Name="CustomerEmailTextBlock"
           Margin="0,4,0,0"
           Foreground="{StaticResource SecondaryText}"/>

                    </StackPanel>
                </Border>

                <!-- Message displayed when the customer has no bookings -->
                <StackPanel x:Name="NoBookingsMessage"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <TextBlock Text="Kunden har inga bokningar."
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryText}"/>

                    <TextBlock Text="Det finns inga bokningar registrerade på den här kunden."
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryText}"/>

                </StackPanel>

                <!-- Booking list -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <!-- Creates one booking card for each booking in the collection -->
                    <ItemsControl x:Name="BookingsItemsControl">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <!-- Booking card -->
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20"
                                        Margin="0,0,0,15">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Booking header -->
                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="Bokning #"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryText}"/>

                                                <TextBlock Text="{Binding BookingID}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryText}"/>

                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryText}"/>

                                        </Grid>

                                        <!-- Accommodation overview -->
                                        <StackPanel Grid.Row="1"
                                                    Margin="0,18,0,0">

                                            <TextBlock Text="BOENDE"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"/>

                                            <!-- Displays the accommodation dates connected to the booking -->
                                            <ItemsControl ItemsSource="{Binding Accommodations}">

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>

                                                        <StackPanel Margin="0,5,0,0">

                                                            <TextBlock Foreground="{StaticResource SecondaryText}">

                                                                <Run Text="{Binding StartDate,
                                                                    StringFormat={}{0:yyyy-MM-dd}}"/>

                                                                <Run Text=" – "/>

                                                                <Run Text="{Binding EndDate,
                                                                    StringFormat={}{0:yyyy-MM-dd}}"/>

                                                            </TextBlock>

                                                        </StackPanel>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                        <!-- Booking footer -->
                                        <Grid Grid.Row="2"
                                              Margin="0,20,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Total booking amount -->
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="Totalt: "
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryText}"/>

                                                <TextBlock Text="{Binding TotalAmount,
                                                    StringFormat={}{0:N0} kr}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryText}"/>

                                            </StackPanel>

                                            <!-- Opens the detailed view for this booking -->
                                            <Button Grid.Column="1"
                                                    Content="Visa all information"
                                                    Width="170"
                                                    Height="38"
                                                    Tag="{Binding BookingID}"
                                                    Style="{StaticResource DeepSeaButtonStyle}"
                                                    Click="ShowAllInformation_Click"/>

                                        </Grid>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

                <!-- Back button -->
                <Button Grid.Row="3"
                        Content="Tillbaka"
                        Width="110"
                        Height="38"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource DeepSeaButtonStyle}"
                        Click="BackButton_Click"/>

            </Grid>
        </Border>
    </Grid>
</Window>