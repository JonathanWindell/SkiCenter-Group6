<Window x:Class="PresentationLayer.Views.StatisticsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PresentationLayer.Controls"
        Title="SkiCenter - Statistik"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WindowBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
        </Style>

        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="TileCompareStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        </Style>

        <Style x:Key="StatisticsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="14"
            Margin="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel>
                    <Button Content="← Tillbaka"
                            Width="110"
                            Height="36"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="BackButton_Click"/>
                    
                    <TextBlock Text="Statistik"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryText}"/>
                    <TextBlock Text="Beläggning och försäljning per månad, jämfört med samma månader föregående år."
                               FontSize="14"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>

                <!-- Printable reports: saved as PDF and opened in the PDF viewer -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1">
                    <TextBlock Text="Rapporter som PDF"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                              
                               Margin="0,8,0,4"
                               Foreground="{StaticResource PrimaryText}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StatisticsPdfButton" Content="Statistikrapport" Width="125" Height="30" Margin="0,0,8,0"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        <Button x:Name="CustomerRegisterPdfButton" Content="Kundregister" Width="110" Height="30" Margin="0,0,8,0"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        <Button x:Name="EquipmentRegisterPdfButton" Content="Utrustningsregister" Width="135" Height="30" Margin="0,0,8,0"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                        <Button x:Name="PriceListPdfButton" Content="Prislistor" Width="95" Height="30"
                                Style="{StaticResource DeepSeaButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Från månad" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="FromMonthComboBox" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Till månad" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="ToMonthComboBox" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Boendetyp" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="AccommodationTypeComboBox" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <CheckBox x:Name="CompareCheckBox"
                          Grid.Column="6"
                          Content="Jämför med föregående år"
                          IsChecked="True"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,8"
                          Foreground="{StaticResource PrimaryText}"/>

                <Button x:Name="ShowStatisticsButton"
                        Grid.Column="8"
                        Content="Visa statistik"
                        Width="130"
                        Height="34"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource DeepSeaButtonStyle}"/>

                <TextBlock x:Name="MessageTextBlock"
                           Grid.Column="9"
                           Margin="12,0,0,8"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           Foreground="#DC2626"/>
            </Grid>

            <!-- Key figures -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,0,-12,14">
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Beläggning" Style="{StaticResource TileTitleStyle}"/>
                        <TextBlock x:Name="OccupancyValueTextBlock" Text="–" Style="{StaticResource TileValueStyle}"/>
                        <TextBlock x:Name="OccupancyCompareTextBlock" Style="{StaticResource TileCompareStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Försäljning exkl. moms" Style="{StaticResource TileTitleStyle}"/>
                        <TextBlock x:Name="SalesValueTextBlock" Text="–" Style="{StaticResource TileValueStyle}"/>
                        <TextBlock x:Name="SalesCompareTextBlock" Style="{StaticResource TileCompareStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Bokningar" Style="{StaticResource TileTitleStyle}"/>
                        <TextBlock x:Name="BookingsValueTextBlock" Text="–" Style="{StaticResource TileValueStyle}"/>
                        <TextBlock x:Name="BookingsCompareTextBlock" Style="{StaticResource TileCompareStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileStyle}">
                    <StackPanel>
                        <TextBlock Text="Bokade nätter" Style="{StaticResource TileTitleStyle}"/>
                        <TextBlock x:Name="NightsValueTextBlock" Text="–" Style="{StaticResource TileValueStyle}"/>
                        <TextBlock x:Name="NightsCompareTextBlock" Style="{StaticResource TileCompareStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <controls:BarChart x:Name="OccupancyChart" Title="Beläggning per månad"/>
                </Border>

                <Border Grid.Column="2" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <controls:BarChart x:Name="SalesChart" Title="Försäljning (kr exkl. moms)"/>
                </Border>
            </Grid>

            <!-- Table per month -->
            <Border Grid.Row="4" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="12" Padding="1">
                <DataGrid x:Name="StatisticsDataGrid" Style="{StaticResource StatisticsGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Månad" Binding="{Binding Month}" Width="1.1*"/>
                        <DataGridTextColumn Header="Beläggning" Binding="{Binding Occupancy}" Width="*"/>
                        <DataGridTextColumn x:Name="PreviousOccupancyColumn" Header="Fg. år" Binding="{Binding PreviousOccupancy}" Width="0.8*"/>
                        <DataGridTextColumn Header="Nätter" Binding="{Binding BookedNights}" Width="0.7*"/>
                        <DataGridTextColumn Header="Bokningar" Binding="{Binding BookingCount}" Width="0.8*"/>
                        <DataGridTextColumn Header="Boende" Binding="{Binding AccommodationSales}" Width="*"/>
                        <DataGridTextColumn Header="Utrustning" Binding="{Binding EquipmentSales}" Width="*"/>
                        <DataGridTextColumn Header="Skidskola" Binding="{Binding SkiSchoolSales}" Width="*"/>
                        <DataGridTextColumn Header="Totalt" Binding="{Binding TotalSales}" Width="*"/>
                        <DataGridTextColumn x:Name="PreviousSalesColumn" Header="Fg. år" Binding="{Binding PreviousSales}" Width="*"/>
                        <DataGridTextColumn x:Name="SalesChangeColumn" Header="Förändring" Binding="{Binding SalesChange}" Width="0.9*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</Window>
