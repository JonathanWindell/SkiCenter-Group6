<Window x:Class="PresentationLayer.Views.SeasonPriceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Säsongspriser"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <!-- Shared look for both price tables, matching the equipment view. -->
        <Style x:Key="PriceGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shows who registered a price. Prices from before history was tracked have no staff member. -->
        <DataTemplate x:Key="ChangedByCellTemplate">
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding ChangedBy.FirstName, Mode=OneWay, FallbackValue='Ursprungligt pris', TargetNullValue='Ursprungligt pris'}"/>
                <Run Text="{Binding ChangedBy.LastName, Mode=OneWay, FallbackValue='', TargetNullValue=''}"/>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DeepSeaButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="22"
            Margin="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Säsongspriser"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Aktuella priser per boendetyp, pristyp och vecka. Tidigare priser sparas som historik."
                           FontSize="14"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Boendetyp"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="TypeFilterComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Pristyp"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="PriceTypeFilterComboBox"
                              Height="34"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Vecka"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="WeekFilterTextBox"
                             Height="34"
                             Padding="6,3"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource InputBorder}"/>
                </StackPanel>

                <Button x:Name="FilterButton"
                        Grid.Column="6"
                        Content="Filtrera"
                        Width="100"
                        Height="34"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource DeepSeaButtonStyle}"/>

                <Button x:Name="ClearFilterButton"
                        Grid.Column="8"
                        Content="Rensa"
                        Width="100"
                        Height="34"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                <TextBlock x:Name="FilterErrorTextBlock"
                           Grid.Column="9"
                           Margin="14,0,0,8"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           Foreground="#DC2626"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- Current prices -->
                <Border Grid.Column="0"
                        CornerRadius="12"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        Background="{StaticResource CardBg}"
                        Padding="1">
                    <DataGrid x:Name="PriceDataGrid" Style="{StaticResource PriceGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Vecka"
                                                Binding="{Binding WeekNumber}"
                                                Width="0.6*"/>
                            <DataGridTextColumn Header="Boendetyp"
                                                Binding="{Binding AccommodationType.CategoryCode}"
                                                Width="0.8*"/>
                            <DataGridTextColumn Header="Pristyp"
                                                Binding="{Binding PriceType}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Pris (kr)"
                                                Binding="{Binding Price, StringFormat=N2}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Gäller från"
                                                Binding="{Binding ValidFrom, StringFormat=yyyy-MM-dd HH:mm}"
                                                Width="1.2*"/>
                            <DataGridTemplateColumn Header="Ändrad av"
                                                    CellTemplate="{StaticResource ChangedByCellTemplate}"
                                                    Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Edit panel -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Ändra pris"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="SelectedPriceTextBlock"
                                       Text="Välj en rad i tabellen."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Nytt pris (kr) *"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,4"/>

                            <TextBox x:Name="NewPriceTextBox"
                                     Height="32"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource InputBorder}"
                                     IsEnabled="False"/>

                            <TextBlock x:Name="PriceFeedbackTextBlock"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,8"/>

                            <Button x:Name="SavePriceButton"
                                    Content="Spara nytt pris"
                                    Height="36"
                                    IsEnabled="False"
                                    Style="{StaticResource DeepSeaButtonStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Prishistorik"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,18,0,6"/>

                        <Border Grid.Row="2"
                                CornerRadius="8"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                Padding="1">
                            <DataGrid x:Name="HistoryDataGrid" Style="{StaticResource PriceGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pris (kr)"
                                                        Binding="{Binding Price, StringFormat=N2}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Gäller från"
                                                        Binding="{Binding ValidFrom, StringFormat=yyyy-MM-dd HH:mm}"
                                                        Width="1.3*"/>
                                    <DataGridTemplateColumn Header="Ändrad av"
                                                            CellTemplate="{StaticResource ChangedByCellTemplate}"
                                                            Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
