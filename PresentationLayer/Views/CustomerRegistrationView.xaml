<Window x:Class="PresentationLayer.Views.CustomerRegistrationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Registrera kund"
        Height="750"
        Width="800"
        MinHeight="550"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Border Background="{StaticResource CardBg}"
                CornerRadius="15"
                Padding="35"
                Margin="40"
                MaxWidth="700">

            <StackPanel>

                <!-- Rubrik -->
                <TextBlock Text="Registrera kund"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Fyll i kundens uppgifter nedan."
                           FontSize="14"
                           Foreground="{StaticResource SecondaryText}"
                           Margin="0,0,0,30"/>

                <!-- Kundtyp -->
                <TextBlock Text="Kundtyp"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="CustomerTypeComboBox"
                          Height="38"
                          SelectedIndex="0"
                          SelectionChanged="CustomerTypeComboBox_SelectionChanged"
                          Margin="0,0,0,20">
                    
                    <ComboBoxItem Content="Privatkund"/>
                    <ComboBoxItem Content="Företagskund"/>
  
                    

                </ComboBox>

                <!-- Förnamn och efternamn -->
                <Grid Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Förnamn *"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="FirstNameTextBox"
                                 Height="38"
                                 Padding="8"
                                 BorderBrush="{StaticResource InputBorder}"/>
                        <TextBlock x:Name="FirstNameError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="0,5,0,0"/>



                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Efternamn *"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="LastNameTextBox"
                                 Height="38"
                                 Padding="8"
                                 BorderBrush="{StaticResource InputBorder}"/>
                        <TextBlock x:Name="LastNameError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Grid>

                <!-- Adress -->
                <TextBlock Text="Adress *"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="AddressTextBox"
                         Height="38"
                         Padding="8"
                         BorderBrush="{StaticResource InputBorder}"
                         Margin="0,0,0,15"/>
                <TextBlock x:Name="AddressError"
                           Foreground="#DC2626"
                           FontSize="12"
                           Visibility="Collapsed"
                           Margin="0,5,0,0"/>

                <!-- E-postadress -->
                <TextBlock Text="E-postadress *"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         Padding="8"
                         BorderBrush="{StaticResource InputBorder}"
                         Margin="0,0,0,15"/>
                <TextBlock x:Name="EmailError"
                           Foreground="#DC2626"
                           FontSize="12"
                           Visibility="Collapsed"
                           Margin="0,5,0,0"/>

                <!-- Telefonnummer -->
                <TextBlock Text="Telefonnummer *"
                           Foreground="{StaticResource PrimaryText}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="PhoneTextBox"
                         Height="38"
                         Padding="8"
                         BorderBrush="{StaticResource InputBorder}"
                         Margin="0,0,0,30"/>
                <TextBlock x:Name="PhoneError"
                           Foreground="#DC2626"
                           FontSize="12"
                           Visibility="Collapsed"
                           Margin="0,5,0,0"/>


                <!-- Företagsuppgifter -->
                <StackPanel x:Name="CorporateFields"
                            Visibility="Collapsed"
                            Margin="0,0,0,20">

                    <!-- Företagsnamn -->
                    <TextBlock Text="Företagsnamn *"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="CompanyNameTextBox"
                             Height="38"
                             Padding="8"
                             BorderBrush="{StaticResource InputBorder}"
                             Margin="0,0,0,15"/>
                    <TextBlock x:Name="CompanyNameError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="0,5,0,0"/>

                    <!-- Organisationsnummer -->
                    <TextBlock Text="Organisationsnummer *"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="OrgNumberTextBox"
                             Height="38"
                             Padding="8"
                             BorderBrush="{StaticResource InputBorder}"
                             Margin="0,0,0,15"/>
                    <TextBlock x:Name="OrgNumberError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="0,5,0,0"/>

                    <!-- Kontaktperson -->
                    <TextBlock Text="Kontaktperson *"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="ContactPersonTextBox"
                             Height="38"
                             Padding="8"
                              BorderBrush="{StaticResource InputBorder}"/>
                    <TextBlock x:Name="ContactPersonError"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Margin="0,5,0,0"/>

                </StackPanel>
                


                <!-- Knappar -->
                <TextBlock x:Name="ValidationMessage"
                           Foreground="#DC2626"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Avbryt"
                            Width="130"
                            Height="40"
                            Margin="0,0,12,0"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="Cancel_Click"/>

                    <Button Content="Spara kund"
                            Width="130"
                            Height="40"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="SaveCustomer_Click"/>


                </StackPanel>





            </StackPanel>

        </Border>

    </ScrollViewer>

</Window>


