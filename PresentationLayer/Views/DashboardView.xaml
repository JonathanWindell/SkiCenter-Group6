<Window x:Class="PresentationLayer.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Dashboard" Height="700" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="MainBorder" Background="{StaticResource WindowBg}" CornerRadius="20" Padding="40,30"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: welcome text, role and window controls -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock x:Name="txtWelcome" FontSize="28" FontWeight="ExtraBold"
                               Foreground="{StaticResource PrimaryText}"/>
                    <TextBlock x:Name="txtRole" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Logga ut" Width="100" Height="34" Margin="0,0,15,0"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="btnLogout_Click"/>
                    <Button Content="−" Click="btnMinimize_Click" Width="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource SecondaryText}" FontSize="18"/>
                    <Button Content="✕" Click="btnClose_Click" Width="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FF5F57" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Menu buttons are generated in code based on the logged in staff member's role -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="MenuPanel" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <TextBlock x:Name="txtNoModules" Grid.Row="1" Visibility="Collapsed"
                       Text="Du har inte behörighet till några delar av systemet."
                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryText}"/>
        </Grid>
    </Border>
</Window>
