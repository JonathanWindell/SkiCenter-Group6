<Window x:Class="PresentationLayer.Views.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Dashboard" Height="700" Width="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Mountain background drawn in the brand colors (Resources/Graphics.xaml) -->
    <Border x:Name="MainBorder" CornerRadius="20" Padding="34,24,34,30"
            Background="{StaticResource MountainBackgroundBrush}"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: logo, welcome text and role, log out and window controls -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource BrandLogoStyle}"
                                Height="66" VerticalAlignment="Center"/>

                <Rectangle Grid.Column="1" Width="1" Height="56" Margin="22,0,24,0"
                           Fill="{StaticResource InputBorder}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="txtWelcome" FontSize="25"
                               Style="{StaticResource HeadingTextStyle}"/>
                    <TextBlock x:Name="txtRole" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource MutedText}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Height="34" Padding="14,0" Margin="0,0,12,0"
                            Style="{StaticResource DeepSeaButtonStyle}"
                            Click="btnLogout_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Canvas Width="64" Height="64">
                                    <Path Data="{StaticResource Icon.Logout}" Stroke="White" Style="{StaticResource IconPathStyle}" StrokeThickness="5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Logga ut" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="−" Click="btnMinimize_Click" Style="{StaticResource WindowChromeButtonStyle}"
                            Foreground="{StaticResource SecondaryText}" FontSize="18"/>
                    <Button Content="✕" Click="btnClose_Click" Style="{StaticResource WindowChromeButtonStyle}"
                            Foreground="#FF5F57" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- Menu cards are generated in code based on the logged in staff member's role -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="-8,0,-8,0">
                <UniformGrid x:Name="MenuPanel" Columns="3" VerticalAlignment="Top"/>
            </ScrollViewer>

            <TextBlock x:Name="txtNoModules" Grid.Row="1" Visibility="Collapsed"
                       Text="Du har inte behörighet till några delar av systemet."
                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryText}"/>
        </Grid>
    </Border>
</Window>
