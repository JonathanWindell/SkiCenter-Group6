<Window x:Class="PresentationLayer.Views.InvoiceExportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Faktureringsunderlag"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <Style x:Key="ExportGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource WindowBg}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource WindowBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource InputBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header matches the ski school view. -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="← Tillbaka"
                    Width="110"
                    Height="36"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="BackButton_Click"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Faktureringsunderlag"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Exportera underlag för avslutade bokningar till ekonomisystemet som JSON."
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource CardBg}"
                CornerRadius="15"
                Padding="20"
                BorderBrush="{StaticResource InputBorder}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="2"
                                  Opacity="0.08"
                                  Color="#1E1B4B"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Utcheckning från *" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="FromDatePicker" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Utcheckning till *" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="ToDatePicker" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Kundtyp" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="CustomerTypeComboBox"
                              Height="32"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Alla kunder" Tag="All"/>
                            <ComboBoxItem Content="Privatkunder" Tag="Private"/>
                            <ComboBoxItem Content="Företagskunder" Tag="Corporate"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="GenerateButton"
                        Grid.Column="6"
                        Content="Hämta underlag"
                        Width="140"
                        Height="34"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource DeepSeaButtonStyle}"/>

                    <TextBlock x:Name="MessageTextBlock"
                           Grid.Column="7"
                           Margin="14,0,0,8"
                           VerticalAlignment="Bottom"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Completed bookings -->
                    <Border Grid.Column="0"
                        CornerRadius="12"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        Padding="1">
                        <DataGrid x:Name="BookingsDataGrid" Style="{StaticResource ExportGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bokning" Binding="{Binding BookingID}" Width="0.6*"/>
                                <DataGridTextColumn Header="Kund" Binding="{Binding Customer.Name}" Width="1.4*"/>
                                <DataGridTextColumn Header="Kundtyp" Binding="{Binding Customer.CustomerType}" Width="*"/>
                                <DataGridTextColumn Header="Utcheckning" Binding="{Binding CheckOutDate, StringFormat=yyyy-MM-dd}" Width="*"/>
                                <DataGridTextColumn Header="Exkl. moms" Binding="{Binding TotalExclVat, StringFormat=N2}" Width="*"/>
                                <DataGridTextColumn Header="Moms" Binding="{Binding TotalVat, StringFormat=N2}" Width="0.8*"/>
                                <DataGridTextColumn Header="Inkl. moms" Binding="{Binding TotalInclVat, StringFormat=N2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- JSON preview -->
                    <Border Grid.Column="2"
                        CornerRadius="12"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Förhandsgranskning (JSON)"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,0,0,6"/>
                            <TextBox x:Name="JsonPreviewTextBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="{StaticResource WindowBg}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Totals and export -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock x:Name="TotalsTextBlock"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryText}"/>
                    <Button x:Name="ExportJsonButton"
                        Content="Exportera JSON"
                        Width="160"
                        Height="38"
                        HorizontalAlignment="Right"
                        IsEnabled="False"
                        Style="{StaticResource DeepSeaButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
