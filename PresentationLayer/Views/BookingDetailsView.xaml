<Window x:Class="PresentationLayer.Views.BookingDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PresentationLayer.Views"
        Title="SkiCenter - Bokningsdetaljer"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <local:BookingStatusSwedishConverter x:Key="BookingStatusSwedishConverter"/>
        <local:AccommodationStatusSwedishConverter x:Key="AccommodationStatusSwedishConverter"/>
        <local:BooleanSwedishConverter x:Key="BooleanSwedishConverter"/>
    </Window.Resources>

    <Grid Margin="40">

        <!-- Main content card -->
        <Border Background="{StaticResource CardBg}"
                CornerRadius="18"
                Padding="35">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Back button -->
                        <Button Content="Tillbaka"
                                Width="90"
                                Height="32"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Left"
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="BackButton_Click"/>

                        <TextBlock FontFamily="{StaticResource HeadingFont}" Text="Bokningsdetaljer"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock Text="Fullständig information om bokningen."
                                   Margin="0,6,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <!-- Confirmation button (Sends mail using EmailNotificationService)-->
                    <Button x:Name="BtnSendConfirmation"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Content="Skicka Bekräftelse"
                            Width="150"
                            Height="38"
                            Style="{StaticResource CtaButtonStyle}"
                            Click="BtnSendConfirmation_Click"/>
                </Grid>

                <!-- Scrollable booking information -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <!-- Booking information -->
                        <Border BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">

                                    <TextBlock Text="Bokning #"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}"/>

                                    <TextBlock Text="{Binding BookingID}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryText}"/>

                                </StackPanel>

                                <TextBlock>
                                    <Run Text="Bokningsdatum: "/>
                                    <Run Text="{Binding BookingDate,
                                        StringFormat={}{0:yyyy-MM-dd}}"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Status: "/>
                                    <Run Text="{Binding BookingStatus,
                                        Converter={StaticResource BookingStatusSwedishConverter}}"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Avbeställningsskydd: "/>
                                    <Run Text="{Binding HasCancellationInsurance,
                                        Converter={StaticResource BooleanSwedishConverter}}"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Totalt belopp: "/>
                                    <Run Text="{Binding TotalAmount,
                                        StringFormat={}{0:N0} kr}"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Moms boende (12 %): "/>
                                    <Run x:Name="AccomVatRun" Text="-"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Moms övrigt: "/>
                                    <Run x:Name="OtherVatRun" Text="-"/>
                                </TextBlock>

                                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold">
                                    <Run Text="Total moms: "/>
                                    <Run x:Name="TotalVatRun" Text="-"/>
                                </TextBlock>

                            </StackPanel>
                        </Border>

                        <!-- Accommodation information -->
                        <ItemsControl ItemsSource="{Binding Accommodations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15">

                                        <StackPanel>

                                            <TextBlock Text="BOENDE"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       Margin="0,0,0,12"/>

                                            <TextBlock>
                                                <Run Text="Boendenummer: "/>
                                                <Run Text="{Binding Accommodation.AccommodationNumber}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Kategori: "/>
                                                <Run Text="{Binding Accommodation.AccommodationType.CategoryCode}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Beskrivning: "/>
                                                <Run Text="{Binding Accommodation.AccommodationType.Description}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Antal bäddar: "/>
                                                <Run Text="{Binding Accommodation.AccommodationType.NumberOfBeds}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Status: "/>
                                                <Run Text="{Binding Accommodation.Status,
                                                    Converter={StaticResource AccommodationStatusSwedishConverter}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Startdatum: "/>
                                                <Run Text="{Binding StartDate,
                                                    StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Slutdatum: "/>
                                                <Run Text="{Binding EndDate,
                                                    StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Rabatt: "/>
                                                <Run Text="{Binding DataContext.DiscountRate, 
                                                                    RelativeSource={RelativeSource AncestorType=Window}, 
                                                                    StringFormat={}{0:P0}}"/>
                                                <Run Text=" (-"/>
                                                <Run Text="{Binding DataContext.DiscountAmount, 
                                                                    RelativeSource={RelativeSource AncestorType=Window}, 
                                                                    StringFormat={}{0:N0} kr}"/>
                                                <Run Text=")"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Slutpris boende: "/>
                                                <Run Text="{Binding DataContext.FinalAccommodationPrice, 
                                                                    RelativeSource={RelativeSource AncestorType=Window}, 
                                                                    Mode=OneWay, 
                                                                    StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Meeting room information -->
                        <ItemsControl ItemsSource="{Binding MeetingRooms}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20"
                                        Margin="0,0,0,15">
                                        
                                        <StackPanel>
                                            <TextBlock Text="MÖTESRUM" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,12"/>

                                            <TextBlock>
                                                <Run Text="Rumsnummer: "/>
                                                <Run Text="{Binding meetingRoom.MeetingRoomNumber}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Kapacitet: "/>
                                                <Run Text="{Binding meetingRoom.Capacity}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Startdatum: "/>
                                                <Run Text="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Slutdatum: "/>
                                                <Run Text="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Beskrivning: "/>
                                                <Run Text="{Binding meetingRoom.Description}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Pris: "/>
                                                <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Status: "/>
                                                <Run Text="{Binding meetingRoom.Status}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Equipment information -->
                        <ItemsControl ItemsSource="{Binding Rentals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15">

                                        <StackPanel>
                                            <TextBlock Text="UTRUSTNING"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock>
                                                <Run Text="Startdatum: "/>
                                                <Run Text="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>
                                            
                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Slutdatum: "/>
                                                <Run Text="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Status: "/>
                                                <Run Text="{Binding Status}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,15">
                                                <Run Text="Pris för hyresperioden: "/>
                                                <Run Text="{Binding TotalPrice, StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                            <ItemsControl ItemsSource="{Binding RentalItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,5,0,10">
                                                            <TextBlock Text="{Binding EquipmentItem.Equipment.DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryText}"/>

                                                            <TextBlock Margin="0,3,0,0">
                                                                <Run Text="Artikelnummer: "/>
                                                                <Run Text="{Binding EquipmentItem.ArticleNumber}"/>
                                                            </TextBlock>

                                                            <TextBlock Margin="0,3,0,0">
                                                                <Run Text="Kategori: "/>
                                                                <Run Text="{Binding EquipmentItem.Equipment.Category}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ski school information -->
                        <ItemsControl ItemsSource="{Binding SkiLessons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15">

                                        <StackPanel>

                                            <TextBlock Text="SKIDSKOLA"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       Margin="0,0,0,12"/>

                                            <TextBlock>
                                                <Run Text="Nivå: "/>
                                                <Run Text="{Binding SkiLessonSession.SkiLesson.Level}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Vecka: "/>
                                                <Run Text="{Binding SkiLessonSession.WeekNumber}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Dagar: "/>
                                                <Run Text="{Binding SkiLessonSession.SkiLesson.Days}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Tid: "/>
                                                <Run Text="{Binding SkiLessonSession.TimeSlot}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Max deltagare: "/>
                                                <Run Text="{Binding SkiLessonSession.SkiLesson.MaxParticipants}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Pris: "/>
                                                <Run Text="{Binding SkiLessonSession.SkiLesson.Price,
                                                    StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Invoice information -->
                        <ItemsControl ItemsSource="{Binding Invoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border BorderBrush="{StaticResource InputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,15">

                                        <StackPanel>

                                            <TextBlock Text="FAKTURA"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       Margin="0,0,0,12"/>

                                            <TextBlock>
                                                <Run Text="Fakturanummer: "/>
                                                <Run Text="{Binding InvoiceID}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Fakturadatum: "/>
                                                <Run Text="{Binding Date,
                                                    StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Förfallodatum: "/>
                                                <Run Text="{Binding DueDate,
                                                    StringFormat={}{0:yyyy-MM-dd}}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Belopp exkl. moms: "/>
                                                <Run Text="{Binding AmountExcl,
                                                    StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Moms: "/>
                                                <Run Text="{Binding Moms,
                                                    StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Belopp inkl. moms: "/>
                                                <Run Text="{Binding AmountIncl,
                                                    StringFormat={}{0:N0} kr}"/>
                                            </TextBlock>

                                            <TextBlock Margin="0,5,0,0">
                                                <Run Text="Status: "/>
                                                <Run Text="{Binding Status}"/>
                                            </TextBlock>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- Buttons (Add & Cancel booking) -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel booking -->
                    <Button x:Name="CancelBookingButton"
                            Grid.Column="0"
                            Content="Avboka bokning"
                            Width="150"
                            Height="38">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DeepSeaButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#DCEAF7"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Add buttons (Equipment, Ski school, meeting room -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="BtnAddEquipment"
                                Content="+ Lägg till Utrustning"
                                Width="150"
                                Height="38"
                                Margin="0,0,10,0"
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="BtnAddEquipment_Click"/>

                        <Button x:Name="BtnAddSkiSchool"
                                Content="+ Lägg till Skidskola"
                                Width="150"
                                Height="38"
                                Margin="0,0,10,0" 
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="BtnAddSkiSchool_Click"/>

                        <Button x:Name="BtnAddMeetingRoom"
                                Content="+ Lägg till Mötesrum"
                                Width="150"
                                Height="38"
                                Style="{StaticResource DeepSeaButtonStyle}"
                                Click="BtnAddMeetingRoom_Click"/>
                        
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>