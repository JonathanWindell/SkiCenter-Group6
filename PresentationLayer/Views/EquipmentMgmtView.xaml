<!-- Visar utrustning i en skrivskyddad tabell  -->
    <Window x:Class="PresentationLayer.Views.EquipmentMgmtView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Utrustning"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="35"
            Margin="25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Heading -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Utrustning"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Hantera skidshopens utrustning."
                           FontSize="14"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Filter för kategori och status. Filtreringslogiken kopplas in senare. -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kategori"
                   Foreground="{StaticResource PrimaryText}"
                   Margin="0,0,0,8"/>

                    <ComboBox x:Name="CategoryFilterComboBox"
                  Height="38"
                  SelectedIndex="0">
                        <ComboBoxItem Content="Alla kategorier"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Status"
                   Foreground="{StaticResource PrimaryText}"
                   Margin="0,0,0,8"/>

                    <ComboBox x:Name="StatusFilterComboBox"
                  Height="38"
                  SelectedIndex="0">
                        <ComboBoxItem Content="Alla statusar"/>
                        <ComboBoxItem Content="Tillgänglig"/>
                        <ComboBoxItem Content="Skadad"/>
                        <ComboBoxItem Content="Arkiverad"/>
                        <ComboBoxItem Content="Uthyrd"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="AddEquipmentButton"
            Grid.Column="3"
            Content="+ Lägg till utrustning"
            Width="190"
            Height="40"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Style="{StaticResource DeepSeaButtonStyle}"/>
            </Grid>

            <!-- Delar innehållet mellan utrustningstabellen och formuläret. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Equipment table -->
            <DataGrid x:Name="EquipmentDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeight="40"
                      ColumnHeaderHeight="40"
                      Background="{StaticResource CardBg}"
                      Foreground="{StaticResource PrimaryText}"
                      BorderBrush="{StaticResource InputBorder}"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Exemplarnummer"
                                        Width="*"/>
                    <DataGridTextColumn Header="Kategori"
                                        Width="*"/>
                    <DataGridTextColumn Header="Storlek / längd"
                                        Width="*"/>
                    <DataGridTextColumn Header="Status"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

                <!-- Formuläret placeras här i nästa steg. -->
                <Border Grid.Column="2"
            BorderBrush="{StaticResource InputBorder}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="20">
                    <TextBlock Text="Lägg till utrustning"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryText}"/>
                </Border>
            </Grid>
            
        </Grid>
    </Border>
</Window>