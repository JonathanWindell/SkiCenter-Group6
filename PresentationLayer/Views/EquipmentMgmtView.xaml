<Window x:Class="PresentationLayer.Views.EquipmentMgmtView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - Utrustning"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="22"
            Margin="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Compact heading leaves more space for the table and form. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Utrustning"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Hantera skidshopens utrustning."
                           FontSize="14"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Filter controls retain their existing names and options. -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kategori"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>
                    

                    <ComboBox x:Name="CategoryFilterComboBox"
                              Height="34"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Alla kategorier"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Status"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="StatusFilterComboBox"
                              Height="34"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                    </ComboBox>
                </StackPanel>

                <Button x:Name="AddEquipmentButton"
                        Grid.Column="3"
                        Content="+ Lägg till utrustning"
                        Width="185"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource DeepSeaButtonStyle}"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- Equipment list and selection actions. -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="12"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            Background="{StaticResource CardBg}"
                            Padding="1">

                        <DataGrid x:Name="EquipmentDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource InputBorder}"
                                  RowHeight="38"
                                  ColumnHeaderHeight="38"
                                  Background="{StaticResource CardBg}"
                                  Foreground="{StaticResource PrimaryText}"
                                  BorderThickness="0"
                                  AlternatingRowBackground="{StaticResource WindowBg}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"
                                            Value="{StaticResource WindowBg}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource PrimaryText}"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="Padding"
                                            Value="8,0"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush"
                                            Value="{StaticResource InputBorder}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"
                                                    Value="{StaticResource InputBorder}"/>
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource PrimaryText}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Artikelnummer"
                                                    Binding="{Binding ArticleNumber}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Kategori"
                                                    Binding="{Binding Equipment.DisplayName}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="Storlek / längd"
                                                    Binding="{Binding Size}"
                                                    Width="*"/>
                                    
                                <DataGridTextColumn Header="Skick"
                                                    Binding="{Binding Condition}"
                                                    Width="*"/>
                                
                                <DataGridTextColumn Header="Status"
                                                    Binding="{Binding Status}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">

                        <Button x:Name="EditEquipmentButton"
                            Content="Ändra"
                            Width="105"
                            Height="36"
                            IsEnabled="False"
                            Margin="0,0,10,0"
                            Style="{StaticResource DeepSeaButtonStyle}"/>

                        <Button x:Name="DeleteEquipmentButton"
                            Content="Ta bort"
                            Width="105"
                            Height="36"
                            IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button"
                                BasedOn="{StaticResource DeepSeaButtonStyle}">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Paired fields keep the form compact without removing information. -->
                <Border x:Name="EquipmentFormPanel"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.18"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <!-- Scrolling remains available if the content exceeds the space. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="EquipmentFormHeading"
                                       Text="Lägg till utrustning"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Artikelnummer *"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,4"/>

                            <TextBox x:Name="EquipmentNumberTextBox"
                                     Height="32"
                                     Padding="6,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{StaticResource InputBorder}"
                                     Margin="0,0,0,6"/>

                            <TextBlock Text="Kategori *"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,4"/>

                            <ComboBox x:Name="EquipmentCategoryComboBox"
                                      Height="32"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,4"
                                      SelectionChanged="EquipmentCategoryComboBox_SelectionChanged"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Utrustningstyp *" 
                                       Margin="0,10,0,4"/>

                                    <ComboBox x:Name="EquipmentDescriptionComboBox" 
                                      Height="32" 
                                      VerticalContentAlignment="Center"
                                      IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Skick *"
                                             Foreground="{StaticResource PrimaryText}"
                                             Margin="0,10,0,4"/>

                                    <ComboBox x:Name="EquipmentConditionComboBox"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource InputBorder}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Storlek / längd *"
                                               Foreground="{StaticResource PrimaryText}"
                                               Margin="0,0,0,4"/>

                                    <TextBox x:Name="EquipmentSizeTextBox"
                                             Height="32"
                                             Padding="6,3"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource InputBorder}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Status *"
                                               Foreground="{StaticResource PrimaryText}"
                                               Margin="0,0,0,4"/>

                                    <ComboBox x:Name="EquipmentStatusComboBox"
                                              Height="32"
                                              SelectedIndex="0"
                                              VerticalContentAlignment="Center">
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="* Obligatoriska uppgifter"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryText}"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="EquipmentFeedbackTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryText}"
                                       Margin="0,0,0,8"/>

                            <!-- Related actions sit side by side. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="CancelEquipmentButton"
                                        Grid.Column="0"
                                        Content="Avbryt"
                                        Height="36">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource DeepSeaButtonStyle}">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="SaveEquipmentButton"
                                        Grid.Column="2"
                                        Content="Spara utrustning"
                                        Height="36"
                                        Style="{StaticResource DeepSeaButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>