<Window x:Class="PresentationLayer.Views.GuestCheckInOutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkiCenter - In- och utcheckning"
        Width="1000"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <!-- Align table text with the status labels. -->
        <Style x:Key="CenteredGuestText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <!-- Provide pressed and disabled button feedback. -->
        <Style x:Key="GuestActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeepSeaButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuestSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GuestActionButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryText}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="24"
            Margin="16">

        <Border.Triggers>
            <!-- Briefly fade in the view when it opens. -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="In- och utcheckning"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Visa ankomster och avresor för valt datum."
                           FontSize="14"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Date and arrival/departure filters. -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <TextBlock Text="Datum"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource PrimaryText}"/>

                    <DatePicker x:Name="GuestDatePicker"
                                Width="160"
                                Height="36"
                                SelectedDateFormat="Short"
                                Padding="0"
                                VerticalContentAlignment="Center">

                        <DatePicker.Resources>
                            <!-- Centre the editable date text. -->
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                            <Grid Background="Transparent">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Margin="4,0"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <Button x:Name="TodayButton"
                            Content="Idag"
                            Width="75"
                            Height="36"
                            Margin="10,0,0,0"
                            Style="{StaticResource GuestSecondaryButtonStyle}"/>
                </StackPanel>

                <ComboBox x:Name="GuestTypeFilterComboBox"
                          Grid.Column="2"
                          Width="185"
                          Height="36"
                          SelectedIndex="0"
                          AutomationProperties.Name="Visa ankomster eller avresor">
                    <ComboBoxItem Content="Alla"/>
                    <ComboBoxItem Content="Ankomster"/>
                    <ComboBoxItem Content="Avresor"/>
                </ComboBox>
            </Grid>

            <TextBlock x:Name="GuestCountTextBlock"
                       Grid.Row="2"
                       Text="0 bokningar"
                       Margin="0,0,0,10"
                       Foreground="{StaticResource SecondaryText}"/>

            <!-- Read-only list of accommodation arrivals and departures. -->
            <DataGrid x:Name="GuestsDataGrid"
                      Grid.Row="3"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      ColumnHeaderHeight="40"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource InputBorder}"
                      Background="{StaticResource CardBg}"
                      Foreground="{StaticResource PrimaryText}"
                      AlternatingRowBackground="{StaticResource WindowBg}"
                      BorderBrush="{StaticResource InputBorder}"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Boknings-ID"
                                        Binding="{Binding BookingID}"
                                        ElementStyle="{StaticResource CenteredGuestText}"
                                        Width="105"/>

                    <DataGridTextColumn Header="Kund"
                                        Binding="{Binding CustomerName}"
                                        ElementStyle="{StaticResource CenteredGuestText}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Kundtyp"
                                        Binding="{Binding CustomerType}"
                                        ElementStyle="{StaticResource CenteredGuestText}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Boende"
                                        Binding="{Binding AccommodationName}"
                                        ElementStyle="{StaticResource CenteredGuestText}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Händelse"
                                        Binding="{Binding EventType}"
                                        ElementStyle="{StaticResource CenteredGuestText}"
                                        Width="95"/>

                    <DataGridTemplateColumn Header="Betalning" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="10,4"
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PaymentStatus}"
                                                             Value="Fullbetald">
                                                    <Setter Property="Background"
                                                            Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentStatus}"
                                                             Value="Delbetald">
                                                    <Setter Property="Background"
                                                            Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PaymentStatus}"
                                                             Value="Obetald">
                                                    <Setter Property="Background"
                                                            Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding PaymentStatus}"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="#374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                                 Value="Fullbetald">
                                                        <Setter Property="Foreground"
                                                                Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                                 Value="Delbetald">
                                                        <Setter Property="Foreground"
                                                                Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}"
                                                                 Value="Obetald">
                                                        <Setter Property="Foreground"
                                                                Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="10,4"
                                        Margin="6"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StayStatus}"
                                                             Value="Incheckad">
                                                    <Setter Property="Background"
                                                            Value="#EDE9FE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding StayStatus}"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="#374151"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StayStatus}"
                                                                 Value="Incheckad">
                                                        <Setter Property="Foreground"
                                                                Value="#5B21B6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Feedback is shown only when there is a message. -->
            <Border x:Name="GuestFeedbackBorder"
                    Grid.Row="4"
                    Visibility="Collapsed"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,14,0,0">
                <TextBlock x:Name="GuestFeedbackTextBlock"
                           Foreground="#991B1B"
                           TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedGuestTextBlock"
                           Grid.Column="0"
                           Text="Välj en bokning i listan."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,15,0"
                           Foreground="{StaticResource PrimaryText}"/>

                <StackPanel Grid.Column="1" MaxWidth="350">
                    <!-- Permission information will use the logged-in user's access. -->
                    <TextBlock x:Name="GuestPermissionTextBlock"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource SecondaryText}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CheckInButton"
                                Content="Checka in"
                                Width="125"
                                Height="38"
                                IsEnabled="False"
                                Margin="0,0,10,0"
                                Style="{StaticResource GuestActionButtonStyle}"/>

                        <Button x:Name="CheckOutButton"
                                Content="Checka ut"
                                Width="125"
                                Height="38"
                                IsEnabled="False"
                                Style="{StaticResource GuestSecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>