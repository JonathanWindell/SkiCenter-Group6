<Window x:Class="PresentationLayer.Views.PropertyMgmtView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hantera boenden och mötesrum" 
        Width="1050"
        Height="650"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="24"
            Margin="16">

        <Border.Triggers>
            <!-- Briefly fade in the content when the view opens. -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page heading. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Boende- och mötesrumsöversikt"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryText}"/>

                <TextBlock Text="Se boenden och mötesrum, och hantera deras status."
                           Margin="0,8,0,0"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Types and statuses are filtered separately. -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Typ av fastighet"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="PropertyTypeFilterComboBox" 
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Alla typer"/>
                    </ComboBox>
                </StackPanel>

                    <StackPanel Grid.Column="2">
                    <TextBlock Text="Status"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="PropertyStatusFilterComboBox" 
                              Height="36"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Alla statusar"/>
                    </ComboBox>
                </StackPanel>

                    <Button x:Name="ResetFiltersButton"
                        Grid.Column="4"
                        Content="Återställ filter"
                        Height="36"
                        Width="140"
                        VerticalAlignment="Bottom">
                        <Button.Style>
                            <Style TargetType="Button"
                               BasedOn="{StaticResource DeepSeaButtonStyle}">
                                <Setter Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource PrimaryText}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock x:Name="PropertyCountTextBlock"
                       Grid.Row="2"
                       Text="Antal val med aktuell status"
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,0,0,10"/>

                <!-- List of accommodations and meeting rooms. -->
                <Border Grid.Row="3"
                    CornerRadius="10"
                    BorderBrush="{StaticResource InputBorder}"
                    BorderThickness="1"
                    Padding="1">

                    <DataGrid x:Name="PropertyDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeight="42"
                              ColumnHeaderHeight="40"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource InputBorder}"
                              Background="{StaticResource CardBg}"
                              Foreground="{StaticResource PrimaryText}"
                              AlternatingRowBackground="{StaticResource WindowBg}"
                              BorderThickness="0">
                        <DataGrid.RowStyle>
                            <!-- Changes the font of changed row before writing to Db. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                    <DataGrid.Resources>
                        <!-- Align text with the status labels. -->
                        <Style x:Key="CenteredCellText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGrid.Resources>

                        <!-- Property status tags use both text and colour. -->
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Typ"
                                            Binding="{Binding Type}"
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Nummer"
                                            Binding="{Binding Number}"
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Kategori"
                                            Binding="{Binding Category}"
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Kapacitet"
                                            Binding="{Binding Capacity}"
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                      Height="30"
                                      VerticalContentAlignment="Center"
                                      Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>

                <!-- Back button -->
                <Button Grid.Row="4"
                    Content="Tillbaka"
                    Width="110"
                    Height="38"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="BackButton_Click"/>

                <Button x:Name="ChangePropertyStatusButton"
                    Grid.Row="4"
                    Content="Ändra status"
                    Width="140"
                    Height="38"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="ChangePropertyStatusButton_Click">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>

                    <Button.Triggers>
                        <!-- Gently enlarge the button on hover. -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                        To="1.03" Duration="0:0:0.12"/>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                        To="1.03" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Return to normal size when the pointer leaves. -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                        To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation
                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                        To="1" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
        </Grid>
    </Border>
</Window>
