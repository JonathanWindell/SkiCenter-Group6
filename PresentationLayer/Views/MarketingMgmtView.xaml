<Window x:Class="PresentationLayer.Views.MarketingMgmtView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hantera kreditgränser och företagskunder" 
        Height="700" 
        Width="1050"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <Border Background="{StaticResource CardBg}"
            CornerRadius="15"
            Padding="24"
            Margin="16">

        <Border.Triggers>
            <!-- Briefly fade in the content when the view opens. -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rubrik och ingress -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Kredit- och avtalshantering" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryText}"/>
                <TextBlock Text="Hantera kreditgränser och godkänn företagskunder." 
                           Margin="0,8,0,0"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- Filter-sektion -->
            <Border Grid.Row="1" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sök företag / org.nr" 
                                   Foreground="{StaticResource PrimaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="SearchFilterTextBox" 
                                 Height="36" 
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" 
                            x:Name="ResetFiltersButton" 
                            Content="Återställ filter" 
                            Width="140" 
                            Height="36" 
                            VerticalAlignment="Bottom">
                        <Button.Style>
                            <Style TargetType="Button"
                                BasedOn="{StaticResource DeepSeaButtonStyle}">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground"
                                    Value="{StaticResource PrimaryText}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="CorpCustomerCountTextBlock"
                       Grid.Row="2"
                       Text="Antal kunder som behöver hanteras: "
                       Foreground="{StaticResource SecondaryText}"
                       Margin="0,0,0,10"/>

            <!-- List of CorpCustomers awaiting approval. -->
            <Border Grid.Row="3" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="CustomersDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeight="42"
                              ColumnHeaderHeight="40"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource InputBorder}"
                              Background="{StaticResource CardBg}"
                              Foreground="{StaticResource PrimaryText}"
                              AlternatingRowBackground="{StaticResource WindowBg}"
                              BorderThickness="0">
                    <DataGrid.RowStyle>
                        <!-- Changes the font of changed row before writing to Db. -->
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Resources>
                        <!-- Align text with the status labels. -->
                        <Style x:Key="CenteredCellText" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Företagsnamn" 
                                            Binding="{Binding CompanyName}" 
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="2*" 
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Org.nummer" 
                                            Binding="{Binding OrgNumber}" 
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="*" 
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Kontaktperson" 
                                            Binding="{Binding ContactPerson}" 
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="1.5*" 
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" 
                                            Binding="{Binding Status}" 
                                            ElementStyle="{StaticResource CenteredCellText}"
                                            Width="100" 
                                            IsReadOnly="True"/>

                        <!-- Creditlimit that can be edited. -->
                        <DataGridTemplateColumn Header="Kreditgräns (kr)" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                             Height="30" 
                                             VerticalContentAlignment="Center" 
                                             Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Discount rate that can be edited -->
                        <DataGridTemplateColumn Header="Rabatt (%)" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DiscountRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                             Height="30" 
                                             VerticalContentAlignment="Center" 
                                             Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Approve CheckBox -->
                        <DataGridCheckBoxColumn Header="Godkänn" 
                            Binding="{Binding IsApproved, UpdateSourceTrigger=PropertyChanged}" 
                            Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Back button -->
            <Button Grid.Row="4"
                    x:Name="BackButton" 
                    Content="Tillbaka" 
                    Width="110" 
                    Height="38" 
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="BackButton_Click"/>

            <Button Grid.Row="4"
                    x:Name="SaveRowsButton" 
                    Content="Spara ändringar" 
                    Width="140"
                    Height="38" 
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource DeepSeaButtonStyle}"
                    Click="SaveRowsButton_Click">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
            
                <Button.Triggers>
                    <!-- Gently enlarge the button on hover. -->
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                    To="1.03" Duration="0:0:0.12"/>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                    To="1.03" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <!-- Return to normal size when the pointer leaves. -->
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                    To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                    To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Border>
</Window>